{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website4c4milo",
  "compatibility_date": "2026-09-29",
  "main": "./worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "c4milo.com",
      "zone_name": "c4milo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.c4milo.com",
      "zone_name": "c4milo.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BREVO_DOI_TEMPLATE_ID": "2",
    "BREVO_LIST_NAME": "c4milo Updates",
    "BREVO_DOI_TEMPLATE_NAME": "c4milo Email Confirmation"
  }
}
