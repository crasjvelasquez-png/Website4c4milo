{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website4c4milo",
  "compatibility_date": "2026-09-29",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BREVO_LIST_NAME": "c4milo Updates",
    "BREVO_DOI_TEMPLATE_NAME": "c4milo Email Confirmation"
  }
}
